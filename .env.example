# Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Remote Model API (Optional: to bypass 512MB RAM limits)
# Set this to your Model API URL (e.g., Hugging Face Space URL)
# REMOTE_MODEL_URL=https://your-model-api.onrender.com
